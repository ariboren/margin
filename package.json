{
    "name": "margin-md",
    "version": "0.1.0",
    "private": false,
    "description": "Review AI-written markdown like a Google Doc",
    "keywords": [
        "markdown",
        "review",
        "comments",
        "suggestions",
        "ai-agents",
        "claude-code",
        "cli"
    ],
    "license": "MIT",
    "author": "Ari Borensztein",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ariboren/margin.git"
    },
    "homepage": "https://github.com/ariboren/margin#readme",
    "bugs": "https://github.com/ariboren/margin/issues",
    "type": "module",
    "bin": {
        "margin": "src/cli/main.ts",
        "margin-md": "src/cli/main.ts"
    },
    "files": [
        "src/cli",
        "src/core",
        "src/server",
        "!**/*.test.ts",
        "!src/cli/testing.ts",
        "!src/core/testing.ts",
        "!src/server/dev-open.ts",
        "dist/client",
        "skill/margin/SKILL.md",
        "AGENTS.snippet.md"
    ],
    "engines": {
        "bun": ">=1.3"
    },
    "packageManager": "bun@1.3.10",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "build": "bun scripts/build.ts",
        "mockup": "bun mockup/build.ts",
        "budget": "bun scripts/budget.ts",
        "budget:private": "bun scripts/budget.ts --sample private",
        "link-sample": "bun scripts/link-sample.ts",
        "skill": "bun skill/generate.ts",
        "format": "prettier --write .",
        "prepack": "bun scripts/build.ts",
        "pack-check": "bun scripts/pack-check.ts",
        "coverage": "bun scripts/coverage.ts"
    },
    "dependencies": {
        "diff": "^9.0.0",
        "mdast-util-from-markdown": "^2.0.3",
        "mdast-util-frontmatter": "^2.0.1",
        "mdast-util-gfm": "^3.1.0",
        "mdast-util-to-string": "^4.0.0",
        "micromark-extension-frontmatter": "^2.0.0",
        "micromark-extension-gfm": "^3.0.0"
    },
    "devDependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/source-serif-4": "^5.3.0",
        "@tailwindcss/cli": "^4.3.3",
        "@types/bun": "^1.4.2",
        "@types/mdast": "^4.0.4",
        "@types/unist": "^3.0.3",
        "fast-check": "^4.10.2",
        "preact": "^11.0.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2"
    }
}
